{
  "manifest_version": 3,
  "name": "Send to Tools downloader",
  "version": "0.1.0",
  "description": "Queue the current tab URL for the local Tools youtube-downloader workflow.",
  "permissions": ["contextMenus", "nativeMessaging", "activeTab", "tabs"],
  "action": {
    "default_title": "Send to Tools downloader",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
